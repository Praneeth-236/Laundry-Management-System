NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/laundry?replicaSet=rs0
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
UPLOAD_DIR=./server/uploads
PHOTO_STORAGE_DRIVER=local
# For persistent private object storage (for example Cloudflare R2), set the following secrets in the host:
# PHOTO_STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=your-private-bucket-name
# S3_ACCESS_KEY_ID=your-bucket-scoped-access-key
# S3_SECRET_ACCESS_KEY=your-bucket-scoped-secret-key
